\newif\ifgraphicscache@render
\newif\ifgraphicscache@disable
\newif\ifgraphicscache@compress
\newif\ifgraphicscache@listing
\newif\ifgraphicscache@hashshortnames
\newif\ifgraphicscache@gsnotavailable\graphicscache@gsnotavailablefalse
\newif\ifgraphicscache@dorender
\newif\ifgraphicscache@trim
\newif\ifgraphicscache@clip
\newif\ifgraphicscache@fullclip
\newif\ifgraphicscache@flatten\graphicscache@flattenfalse
\newif\ifgraphicscache@cmyk\graphicscache@cmykfalse
\def\graphicscache@graphicsargs{}
\newlength\graphicscache@tmplen
\newcommand{\graphicscache@addarg}[1]{%
  \ifx\graphicscache@graphicsargs\empty
    \edef\graphicscache@graphicsargs{#1}%
  \else
    \edef\graphicscache@graphicsargs{\graphicscache@graphicsargs,#1}%
  \fi
}
%    \end{macrocode}
% Arguments that do not influence the rendered image (e.g.\ |alt|) are not
% hashed and only passed to the final |\includegraphics| call.
%    \begin{macrocode}
\def\graphicscache@includeargs{}
\newcommand{\graphicscache@addincludearg}[1]{%
  \ifx\graphicscache@includeargs\empty
    \edef\graphicscache@includeargs{#1}%
  \else
    \edef\graphicscache@includeargs{%
      \unexpanded\expandafter{\graphicscache@includeargs},#1}%
  \fi
}
\def\graphicscache@parsetrim#1 #2 #3 #4 #5\\{%
  \Gin@defaultbp\graphicscache@trim@l{#1}%
  \Gin@defaultbp\graphicscache@trim@b{#2}%
  \Gin@defaultbp\graphicscache@trim@r{#3}%
  \Gin@defaultbp\graphicscache@trim@t{#4}%
  \graphicscache@trimtrue
}
\pgfkeys{
  /graphicscache/.cd,
  render/.is if=graphicscache@render,
  render=true,
%    \end{macrocode}
%    \begin{macrocode}
  disable/.is if=graphicscache@disable,
  disable=false,
%    \end{macrocode}
%    \begin{macrocode}
  cachedir/.store in=\graphicscache@cachedir,
  cachedir={graphicscache},
%    \end{macrocode}
%    \begin{macrocode}
  compress/.is choice,
  compress/false/.code={\graphicscache@compressfalse \def\graphicscache@compress@mode{off}},
  compress/jpeg/.code={\graphicscache@compresstrue \def\graphicscache@compress@mode{DCTEncode}},
  compress/flat/.code={\graphicscache@compresstrue \def\graphicscache@compress@mode{FlateEncode}},
  compress/flate/.code={\graphicscache@compresstrue \def\graphicscache@compress@mode{FlateEncode}},
  compress=jpeg,
%    \end{macrocode}
%    \begin{macrocode}
  dpi/.store in=\graphicscache@dpi,
  dpi=300,
%    \end{macrocode}
%    \begin{macrocode}
  flatten/.is if=graphicscache@flatten,
  cmyk/.is if=graphicscache@cmyk,
  output icc profile/.store in=\graphicscache@outputicc,
  output icc profile={},
%    \end{macrocode}
%    \begin{macrocode}
  qfactor/.store in=\graphicscache@qfactor,
  qfactor={0.15},
%    \end{macrocode}
%    \begin{macrocode}
  hashshortnames/.is if=graphicscache@hashshortnames,
  hashshortnames=false,
%    \end{macrocode}
%    \begin{macrocode}
  fullclip/.is if=graphicscache@fullclip,
%    \end{macrocode}
% We now define the list of supported graphicx arguments:
%    \begin{macrocode}
  width/.code={%
    \ifx#1!%
      \graphicscache@addarg{width=!}%
    \else
      \setlength\graphicscache@tmplen{#1}%
      \graphicscache@addarg{width=\the\graphicscache@tmplen}%
    \fi
  },
  height/.code={%
    \ifx#1!%
      \graphicscache@addarg{height=!}%
    \else
      \setlength\graphicscache@tmplen{#1}%
      \graphicscache@addarg{height=\the\graphicscache@tmplen}%
    \fi
  },
  trim/.code={\graphicscache@addarg{trim=#1}\graphicscache@parsetrim#1 \\},
  clip/.code={\graphicscache@addarg{clip}\graphicscache@cliptrue},
  angle/.code={%
    \edef\graphicscache@tmp{#1}%
    \graphicscache@addarg{angle=\graphicscache@tmp}%
  },
  origin/.code={\graphicscache@addarg{origin=#1}},
  keepaspectratio/.code={\graphicscache@addarg{keepaspectratio}},
  scale/.code={%
    \edef\graphicscache@tmp{#1}%
    \graphicscache@addarg{scale=\graphicscache@tmp}%
  },
  page/.code={%
    \edef\graphicscache@tmp{#1}%
    \graphicscache@addarg{page=\graphicscache@tmp}%
  },
  listing/.is if=graphicscache@listing,
  listing=false,
%
% adjustbox package
%
  frame/.code={%
    \edef\graphicscache@tmp{#1}%
    \graphicscache@addarg{frame=\graphicscache@tmp}%
  },
  valign/.code={%
    \edef\graphicscache@tmp{#1}%
    \graphicscache@addarg{valign=\graphicscache@tmp}%
  },
  raise/.code={%
    \edef\graphicscache@tmp{#1}%
    \graphicscache@addarg{raise=\graphicscache@tmp}%
  },
%
% keys that do not influence the rendering
%
  alt/.code={%
    \@ifundefined{KV@Gin@alt}{}{%
      \graphicscache@addincludearg{alt={\unexpanded{#1}}}%
    }%
  },
%
% unknown package options
%
  .unknown/.code={%
    \PackageError{graphicscache}{Unknown package option
      `\pgfkeyscurrentname'}{See the graphicscache documentation for the
      list of supported options.}%
  },
}
\ProcessPgfOptions{/graphicscache}\relax
%    \end{macrocode}
% After option processing, unknown keys can only come from
% |\includegraphics| calls. We collect them, so that they can be passed
% to the native |\includegraphics| if the cache is disabled for this image.
% Otherwise, |\graphicscache@checkunknown| raises an error.
%    \begin{macrocode}
\def\graphicscache@unknownargs{}
\def\graphicscache@unknownnames{}
\pgfkeys{
  /graphicscache/.unknown/.code={%
    \def\graphicscache@tmp{#1}%
    \ifx\graphicscache@tmp\pgfkeysnovalue@text
      \edef\graphicscache@unknownargs{%
        \unexpanded\expandafter{\graphicscache@unknownargs},%
        \pgfkeyscurrentname}%
    \else
      \edef\graphicscache@unknownargs{%
        \unexpanded\expandafter{\graphicscache@unknownargs},%
        \pgfkeyscurrentname={\unexpanded{#1}}}%
    \fi
    \ifx\graphicscache@unknownnames\empty
      \edef\graphicscache@unknownnames{\pgfkeyscurrentname}%
    \else
      \edef\graphicscache@unknownnames{%
        \graphicscache@unknownnames, \pgfkeyscurrentname}%
    \fi
  },
}
\newcommand{\graphicscache@checkunknown}{%
  \ifx\graphicscache@unknownnames\empty\else
    \PackageError{graphicscache}{Unsupported \string\includegraphics\space
      key(s): \graphicscache@unknownnames}{graphicscache parses the
      \string\includegraphics\space options itself to compute the cache
      key\MessageBreak
      and only supports: width, height, trim, clip, angle, origin,
      keepaspectratio,\MessageBreak
      scale, page, frame, valign, raise, alt, and the package options.%
      \MessageBreak
      If you press <return>, the key(s) will be ignored.\MessageBreak
      To use the key(s), bypass the cache for this image with
      disable=true.\MessageBreak
      If you think a key should be supported, please open an issue at
      \MessageBreak
      https://github.com/xqms/graphicscache/issues}%
    \def\graphicscache@unknownargs{}%
  \fi
}
\ifgraphicscache@listing
  \newwrite\graphicscache@listout
  \immediate\openout\graphicscache@listout=\jobname.graphicscache
  \RequirePackage{currfile}
\fi
%
% Rendering requires unrestricted shell escape (|pdflatex| is not on the list
% of programs allowed in restricted mode). Without it, we still use existing
% cache files, but cannot create new ones. In that case, we warn once at the
% end of the document.
\newif\ifgraphicscache@shellescape\graphicscache@shellescapetrue
\newcount\graphicscache@notrendered
\def\graphicscache@shellescapestate{enabled}
\ifdefined\pdf@shellescape
  \ifcase\pdf@shellescape
    \graphicscache@shellescapefalse
    \def\graphicscache@shellescapestate{disabled}
  \or
  \else
    \graphicscache@shellescapefalse
    \def\graphicscache@shellescapestate{restricted}
  \fi
\fi
\AtEndDocument{%
  \ifnum\graphicscache@notrendered>0
    \PackageWarningNoLine{graphicscache}{\the\graphicscache@notrendered\space
      image(s) could not be rendered, since%
      \MessageBreak shell escape is \graphicscache@shellescapestate. They were%
      \MessageBreak included directly, without caching and%
      \MessageBreak compression. Compile with -shell-escape%
      \MessageBreak to enable graphicscache}%
  \fi
}
%
% shellesc has a bug on Ubuntu 16.04 (\ShellEscape is not immediate).
% So we simply define our own shellescape macro.
\ifx\lastsavedimageresourcepages\@undefined
  \protected\def\graphicscache@ShellEscape{\immediate\write18 }
\else
  \protected\def\graphicscache@ShellEscape#1{%
    \directlua{os.execute("\luaescapestring{#1}")}}
\fi
%    \end{macrocode}
%    \begin{macrocode}
\newcommand{\graphicscache@isbitmap}[1]{%
  \fullexpandarg
  \IfSubStr*{,png,PNG,jpg,JPG,jpeg,JPEG,}{,#1,}%
}
\def\graphicscache@trunc#1.#2\@empty{#1}%
\newcommand{\graphicscache@pix}[2]{%
  % Compute trim amount in pixels
  \edef\graphicscache@trimtmp{\fpeval{#2 * \graphicscache@fdpi}}%
  % Now truncate & compute remainder
  \edef#1{\expandafter\graphicscache@trunc\graphicscache@trimtmp.\@empty}%
  \edef#2{\fpeval{(\graphicscache@trimtmp - #1) / \graphicscache@fdpi}}%
}
%    \end{macrocode}
%
% \begin{macro}{\graphicscache@callgswithname}
%    This macro calls ghostscript using the name specified in the first argument.
%    \begin{macrocode}
\newcommand{\graphicscache@callgswithname}[1]{%
  \ifgraphicscache@flatten
    \def\graphicscache@flattenarg{-dHaveTransparency=false}%
  \else
    \def\graphicscache@flattenarg{}%
  \fi
  \ifgraphicscache@cmyk
    \def\graphicscache@cmykarg{%
      -sProcessColorModel=DeviceCMYK
      -sColorConversionStrategy=CMYK
      -sColorConversionStrategyForImages=CMYK
    }%
  \else
    \def\graphicscache@cmykarg{}%
  \fi
  \ifdefempty{\graphicscache@outputicc}{%
    \def\graphicscache@outputiccarg{}%
  }{%
    \edef\graphicscache@outputiccarg{-sOutputICCProfile="\graphicscache@outputicc"}%
  }%
  \ifwindows
    \graphicscache@ShellEscape{#1
      -sOutputFile="\graphicscache@output"
      -sDEVICE=pdfwrite
      -dCompatibilityLevel=1.4
      -dPDFSETTINGS=/prepress
      -dNOPAUSE -dQUIET -dBATCH
      \graphicscache@flattenarg\space \graphicscache@cmykarg\space \graphicscache@outputiccarg\space
      -c "<<
        /AutoFilterColorImages false
        /EncodeColorImages true
        /ColorImageFilter /\graphicscache@compress@mode\space
        /ColorImageDict << /ColorTransform 1 /QFactor \graphicscache@qfactor\space /Blend 1 /HSamples [1 1 1 1] /VSamples [1 1 1 1] >>
        /ColorImageResolution \graphicscache@dpi\space
        /AutoFilterGrayImages false
        /EncodeGrayImages true
        /GrayImageFilter /\graphicscache@compress@mode\space
        /GrayImageDict << /ColorTransform 1 /QFactor \graphicscache@qfactor\space /Blend 1 /HSamples [1 1 1 1] /VSamples [1 1 1 1] >>
        /GrayImageResolution \graphicscache@dpi\space
      >> setdistillerparams"
      -f "\graphicscache@raw"
    }%
  \else
    \graphicscache@ShellEscape{#1
      -sOutputFile="\graphicscache@output"
      -sDEVICE=pdfwrite
      -dCompatibilityLevel=1.4
      -dPDFSETTINGS=/prepress
      -dNOPAUSE -dQUIET -dBATCH
      \graphicscache@flattenarg\space \graphicscache@cmykarg\space \graphicscache@outputiccarg\space
      -c '<<
        /AutoFilterColorImages false
        /EncodeColorImages true
        /ColorImageFilter /\graphicscache@compress@mode\space
        /ColorImageDict << /ColorTransform 1 /QFactor \graphicscache@qfactor\space /Blend 1 /HSamples [1 1 1 1] /VSamples [1 1 1 1] >>
        /ColorImageResolution \graphicscache@dpi\space
        /AutoFilterGrayImages false
        /EncodeGrayImages true
        /GrayImageFilter /\graphicscache@compress@mode\space
        /GrayImageDict << /ColorTransform 1 /QFactor \graphicscache@qfactor\space /Blend 1 /HSamples [1 1 1 1] /VSamples [1 1 1 1] >>
        /GrayImageResolution \graphicscache@dpi\space
      >> setdistillerparams'
      -f "\graphicscache@raw" \string|\string| rm -f "\graphicscache@output"
    }%
  \fi
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\graphicscache@callgs}
%    This macro finds the correct ghostscript executable to call.
%    \begin{macrocode}
\newcommand{\graphicscache@callgs}{%
%    \end{macrocode}
%    If we previously established gs is not available, do nothing.
%    \begin{macrocode}
  \@ifundefined{graphicscache@gscommand}{%
    \ifgraphicscache@gsnotavailable\else
      \graphicscache@findgs
    \fi
  }{}%
%    \end{macrocode}
%    Without ghostscript, no cache file is created and the image is included
%    directly (see |\graphicscache@work|).
%    \begin{macrocode}
  \ifgraphicscache@gsnotavailable
  \else
    \PackageInfo{graphicscache}{Calling gs with name '\graphicscache@gscommand'^^J}%
    \graphicscache@callgswithname{\graphicscache@gscommand}%
  \fi
}
\newcommand{\graphicscache@rmgsprobe}{%
  \ifwindows
    \graphicscache@ShellEscape{del /q
      "\graphicscache@cachedir@win\@backslashchar\graphicscache@outputhash.gsprobe"
      2>NUL}%
  \else
    \graphicscache@ShellEscape{rm -f "\graphicscache@gsprobe"}%
  \fi
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\graphicscache@findgs}
%    The ghostscript executable has different names depending on the platform
%    and \TeX{} distribution. We probe the candidates by calling them with
%    |--version| and discarding all output, so that users do not see confusing
%    error messages for missing executables. The probe command always succeeds,
%    a marker file indicates whether the candidate works. The result is stored
%    globally, so that probing happens only once per compilation.
%    \begin{macrocode}
\newcommand{\graphicscache@findgs}{%
  \edef\graphicscache@gsprobe{\graphicscache@cachedir/\graphicscache@outputhash.gsprobe}%
  \graphicscache@rmgsprobe
  \foreach \cmd in {rungs,gs,mgs} {%
    \PackageInfo{graphicscache}{Probing for ghostscript as '\cmd'}%
    \ifwindows
      \graphicscache@ShellEscape{\cmd\space --version >NUL 2>NUL
        \string&\string& echo ok>"\graphicscache@gsprobe"
        \string|\string| ver >NUL}%
    \else
      \graphicscache@ShellEscape{\cmd\space --version >/dev/null 2>&1
        \string&\string& echo ok >"\graphicscache@gsprobe"
        \string|\string| true}%
    \fi
    \IfFileExists{\graphicscache@gsprobe}{%
      \PackageInfo{graphicscache}{Found a working ghostscript called '\cmd'.}%
      \global\edef\graphicscache@gscommand{\cmd}%
      \breakforeach
    }{}%
  }%
  \graphicscache@rmgsprobe
  \@ifundefined{graphicscache@gscommand}{%
    \PackageWarningNoLine{graphicscache}{Could not find a working ghostscript%
      \MessageBreak executable (tried rungs, gs, mgs).%
      \MessageBreak Images will not be compressed}%
    \global\graphicscache@gsnotavailabletrue
  }{}%
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\graphicscache@dorender}
%    Here, we actually perform the rendering. Sadly, this is quite complex due
%    to cross-platform support.
%    \begin{macrocode}
\newcommand{\graphicscache@dorender}{%
  \PackageInfo{graphicscache}{Rendering \graphicscache@outputhash: \graphicscache@fname\space with args: \graphicscache@graphicsargs\space (master file)}%
  \edef\graphicscache@rawname{\graphicscache@outputhash.pdf.raw}%
  \edef\graphicscache@raw{\graphicscache@cachedir/\graphicscache@rawname.pdf}%
  \ifwindows
%    \end{macrocode}
% |cmd.exe| interprets forward slashes as option switches, so we need native
% paths for |md|, |del|, and |copy|.
%    \begin{macrocode}
    \StrSubstitute{\graphicscache@cachedir}{/}{\@backslashchar}[\graphicscache@cachedir@win]%
    \edef\graphicscache@output@win{\graphicscache@cachedir@win\@backslashchar\graphicscache@outputhash.pdf}%
    \edef\graphicscache@raw@win{\graphicscache@cachedir@win\@backslashchar\graphicscache@rawname.pdf}%
    \graphicscache@ShellEscape{md "\graphicscache@cachedir@win" 2>NUL}%
  \else
    \graphicscache@ShellEscape{mkdir -p "\graphicscache@cachedir"}%
  \fi
  \ifgraphicscache@trim
    \ifgraphicscache@clip
      \ifgraphicscache@fullclip
        \ifx\fpeval\undefined
          \PackageError{graphicscache}{The fullclip feature requires the xfp package.}%
        \fi
        \PackageInfo{graphicscache}{Trim: \graphicscache@trim@l, \graphicscache@trim@b, \graphicscache@trim@r, \graphicscache@trim@t}%
        \filename@parse{\graphicscache@fname}%
        \PackageInfo{graphicscache}{Ext: |\filename@ext|}%
        \graphicscache@isbitmap{\filename@ext}{%
          \PackageInfo{graphicscache}{is bitmap!}%
          \graphicscache@ShellEscape{identify -units PixelsPerInch -format '\@percentchar[fx:int(resolution.x)]' "\graphicscache@fname" > "\graphicscache@output.dpi"}%
          \CatchFileDef{\graphicscache@fdpi}{\graphicscache@output.dpi}{}%
          \PackageInfo{graphicscache}{Detected DPI: \graphicscache@fdpi (default 71)}%
          \ifnumequal{\graphicscache@fdpi}{0}{\edef\graphicscache@fdpi{71}}{}%
          \edef\graphicscache@fdpi{\fpeval{0.01389 * \graphicscache@fdpi}}%
          \graphicscache@pix{\graphicscache@trim@l@pix}{\graphicscache@trim@l}%
          \graphicscache@pix{\graphicscache@trim@b@pix}{\graphicscache@trim@b}%
          \graphicscache@pix{\graphicscache@trim@r@pix}{\graphicscache@trim@r}%
          \graphicscache@pix{\graphicscache@trim@t@pix}{\graphicscache@trim@t}%
          \PackageInfo{graphicscache}{Pixel trims:
            \graphicscache@trim@l@pix +\graphicscache@trim@l bp,
            \graphicscache@trim@b@pix +\graphicscache@trim@b bp,
            \graphicscache@trim@r@pix +\graphicscache@trim@r bp,
            \graphicscache@trim@t@pix +\graphicscache@trim@t bp
          }%
          \graphicscache@ShellEscape{convert "\graphicscache@fname" -gravity Northwest -chop \graphicscache@trim@l@pix x\graphicscache@trim@t@pix\space -gravity Southeast -chop \graphicscache@trim@r@pix x\graphicscache@trim@b@pix\space "\graphicscache@output.crop.\filename@ext"}%
          \edef\graphicscache@fname{\graphicscache@output.crop.\filename@ext}%
          \graphicscache@addarg{trim=\graphicscache@trim@l\space\graphicscache@trim@b\space\graphicscache@trim@r\space\graphicscache@trim@t}%
        }{%
          \PackageInfo{graphicscache}{no bitmap!}%
        }%
      \fi
    \fi
  \fi
%    \end{macrocode}
% First, render the graphics.
%    \begin{macrocode}
  \ifwindows
    \graphicscache@ShellEscape{del /q "\graphicscache@raw@win" 2>NUL}%
    \graphicscache@ShellEscape{pdflatex
      -jobname \graphicscache@rawname\space
      -interaction nonstopmode
      -output-directory "\graphicscache@cachedir"
      "\string\documentclass{standalone}
      \string\usepackage{graphicx}
      \string\usepackage[export]{adjustbox}
      \string\begin{document}\string\includegraphics[\graphicscache@graphicsargs]{\graphicscache@fname}\string\end{document}"
    }%
    \IfFileExists{\graphicscache@raw}{}{%
      \PackageWarning{graphicscache}{External pdflatex call failed (see above)}%
      \def\graphicscache@output{}%
    }%
  \else
    \graphicscache@ShellEscape{pdflatex
      -jobname \graphicscache@rawname\space
      -interaction nonstopmode
      -output-directory "\graphicscache@cachedir"
      '\string\documentclass{standalone}
      \string\usepackage{graphicx}
      \string\usepackage[export]{adjustbox}
      \string\begin{document}\string\includegraphics[\graphicscache@graphicsargs]{\graphicscache@fname}\string\end{document}'
      > /dev/null \string|\string| rm "\graphicscache@raw"
    }%
  \fi
%    \end{macrocode}
% Now, call ghostscript for compression---if required, otherwise just copy the
% file.
%    \begin{macrocode}
  \ifgraphicscache@compress
    \PackageInfo{graphicscache}{With compression: \graphicscache@compress@mode}%
    \graphicscache@callgs
  \else
    \PackageInfo{graphicscache}{Direct}%
    \ifwindows
      \graphicscache@ShellEscape{
        copy "\graphicscache@raw@win" "\graphicscache@output@win"
      }%
    \else
      \graphicscache@ShellEscape{
        cp "\graphicscache@raw" "\graphicscache@output"
      }%
    \fi
  \fi
%    \end{macrocode}
% Finally, remove the temporary files (intermediate PDF, latex output files,
% and |fullclip| helper files). Only the final cache file is kept.
%    \begin{macrocode}
  \ifwindows
    \graphicscache@ShellEscape{del /q
      "\graphicscache@raw@win"
      "\graphicscache@cachedir@win\@backslashchar\graphicscache@rawname.aux"
      "\graphicscache@cachedir@win\@backslashchar\graphicscache@rawname.log"
      "\graphicscache@cachedir@win\@backslashchar\graphicscache@outputhash.pdf.dpi"
      "\graphicscache@cachedir@win\@backslashchar\graphicscache@outputhash.pdf.crop.*"
      2>NUL
    }%
  \else
    \graphicscache@ShellEscape{rm -f
      "\graphicscache@raw"
      "\graphicscache@cachedir/\graphicscache@rawname.aux"
      "\graphicscache@cachedir/\graphicscache@rawname.log"
      "\graphicscache@cachedir/\graphicscache@outputhash.pdf.dpi"
      "\graphicscache@cachedir/\graphicscache@outputhash.pdf.crop."*
    }%
  \fi
}
%    \end{macrocode}
% \end{macro}
%
% save original |\includegraphics|
%    \begin{macrocode}
\LetLtxMacro\graphicscache@includegraphics\includegraphics%
\newcommand\graphicscache@native{%
  \edef\graphicscache@nativeargs{%
    \unexpanded\expandafter{\graphicscache@graphicsargs},%
    \unexpanded\expandafter{\graphicscache@includeargs}%
    \unexpanded\expandafter{\graphicscache@unknownargs}}%
  \expandafter\graphicscache@includegraphics\expandafter[\graphicscache@nativeargs]{\graphicscache@fname}%
}
\newcommand\graphicscache@cached{%
  \expandafter\graphicscache@includegraphics\expandafter[\graphicscache@includeargs]{\graphicscache@output}%
}
%    \end{macrocode}
%
% \begin{macro}{\graphicscache@work}
%    This macro performs the update check: Do we need to render the file again
%    or can we just include the cached version?
%    \begin{macrocode}
\newcommand{\graphicscache@work}{%
%    \end{macrocode}
% Parse |\ifgraphicscache@render| and |\graphicscache@inhibit|
%    \begin{macrocode}
    \ifgraphicscache@dorender
%    \end{macrocode}
% Check if output file exists and is newer than input. If we cannot render
% because shell escape is not available, count the image for the summary
% warning at the end of the document. The image is then included directly
% below.
%    \begin{macrocode}
    \filemodcmp{\graphicscache@fname}{\graphicscache@output}{% input is newer
      \ifgraphicscache@shellescape
        \graphicscache@dorender%
      \else
        \PackageInfo{graphicscache}{Cannot render \graphicscache@fname\space
          (shell escape is \graphicscache@shellescapestate)}%
        \global\advance\graphicscache@notrendered by 1\relax
      \fi
    }{% Output is newer
%       \PackageInfo{graphicscache}{Already have \graphicscache@outputhash: \graphicscache@fname}%
    }%
%    \end{macrocode}
% If it still does not exist, we are likely in a strange environment
% (e.g. tabu). In that case, fall back to original includegraphics.
%    \begin{macrocode}
    \filemodcmp{\graphicscache@fname}{\graphicscache@output}{% input is newer/output does not exist
      \graphicscache@native
    }{% otherwise, use the generated file!
      \graphicscache@cached
    }%
  \else
%    \end{macrocode}
% Here, we just look if the output file exists. If not, fall back to
% original includegraphics.
%    \begin{macrocode}
    \IfFileExists{\graphicscache@output}{%
      \graphicscache@cached
    }{%
      \PackageWarning{graphicscache}{Could not find cache file \graphicscache@output, for \graphicscache@fname, falling back to native...}{}%
      \graphicscache@native
    }%
  \fi
}
%    \end{macrocode}
%  \end{macro}
%  \begin{macro}{\graphicscache@getfname}
%    This macro resolves base names (i.e. includegraphics arguments with or
%    without extensions) to relative paths.
%    \begin{macrocode}
\catcode`\*=11
\newif\ifgraphicscache@exists
\newcommand{\graphicscache@getfname}[1]{%
  \ifx\detokenize\@undefined\else
    \edef\Gin@extensions{\detokenize\expandafter{\Gin@extensions}}%
  \fi
  \begingroup
  \global\graphicscache@existstrue
  \let\input@path\Ginput@path
  \ltx@ifpackagelater{graphics}{2017/06/26}{%
    \set@curr@file{#1}%
    \expandafter\filename@parse\expandafter{\@curr@file}%
    \ifx\filename@ext\Gin@gzext
      \expandafter\filename@parse\expandafter{\filename@base}%
      \ifx\filename@ext\relax
        \let\filename@ext\Gin@gzext
      \else
        \edef\Gin@ext{\Gin@ext\Gin@sepdefault\Gin@gzext}%
      \fi
    \fi
  }{%
    \filename@parse{#1}%
  }%
  \ifx\filename@ext\relax
    \@for\Gin@temp:=\Gin@extensions\do{%
      \ifx\Gin@ext\relax
        \Gin@getbase\Gin@temp
      \fi}%
  \else
    \Gin@getbase{\Gin@sepdefault\filename@ext}%
    \ltx@ifpackagelater{graphics}{2017/06/26}{%
      \ifx\Gin@ext\relax
      \let\Gin@savedbase\filename@base
      \let\Gin@savedext\filename@ext
        \edef\filename@base{\filename@base\Gin@sepdefault\filename@ext}%
        \let\filename@ext\relax
         \@for\Gin@temp:=\Gin@extensions\do{%
            \ifx\Gin@ext\relax
              \Gin@getbase\Gin@temp
            \fi}%
        \ifx\Gin@ext\relax
          \let\filename@base\Gin@savedbase
          \let\filename@ext\Gin@savedext
        \fi
      \fi
    }{}%
  \fi
  \ifx\Gin@ext\relax
    \global\graphicscache@existsfalse
  \else
    \@ifundefined{Gin@rule@\Gin@ext}%
      {\global\graphicscache@existsfalse}%
      {}%
  \fi
  \ifgraphicscache@exists
    \xdef\graphicscache@fname{\Gin@base\Gin@ext}%
  \fi
  \endgroup
}
\catcode`\*=12
%    \end{macrocode}
%  \end{macro}
%  \begin{macro}{\includegraphics}
%    Main entry point.
%    \begin{macrocode}
\renewcommand{\includegraphics}[2][]{%
%    \end{macrocode}
% If pdfpages is in use, the best we can do is fall back to native
% includegraphics for the initial call, which is just to figure
% out the number of pages in the PDF.
%    \begin{macrocode}
  \@ifundefined{pdfpages@includegraphics@status}{}{%
    \ifnum\pdfpages@includegraphics@status=2
      \graphicscache@disabletrue
    \fi
  }%
  \ifdefined\graphicscache@inhibit
    \graphicscache@dorenderfalse
  \else
    \ifgraphicscache@render
      \graphicscache@dorendertrue
    \else
      \graphicscache@dorenderfalse
    \fi
  \fi
  \begingroup
  \expandarg
%    \end{macrocode}
% Hash everything!
%    \begin{macrocode}
  \edef\graphicscache@options{\@nameuse{opt@graphicscache.sty}}%
  \pgfkeys{/graphicscache/.cd,#1}%
%    \end{macrocode}
% If we are rendering, we need the actual filename, so that we can check
% modification times. Otherwise, just assume the file exists, |\includegraphics|
% will throw an error itself otherwise.
%    \begin{macrocode}
  \ifgraphicscache@dorender
    \graphicscache@getfname{#2}%
  \else
    \edef\graphicscache@fname{#2}%
    \graphicscache@existstrue
  \fi
%    \end{macrocode}
% Did someone specify disable=true?
%    \begin{macrocode}
  \ifgraphicscache@disable
    \graphicscache@native
  \else
    \graphicscache@checkunknown
    \ifgraphicscache@exists
      \ifgraphicscache@hashshortnames
        \edef\graphicscache@hashedname{#2}%
      \else
        \edef\graphicscache@hashedname{\graphicscache@fname}%
      \fi
      \ifgraphicscache@fullclip
        \def\graphicscache@clipmode{fullclip}%
      \else
        \def\graphicscache@clipmode{nclip}%
      \fi
      \ifgraphicscache@flatten
        \edef\graphicscache@clipmode{\graphicscache@clipmode{}flat}%
      \fi
      \ifgraphicscache@cmyk
        \edef\graphicscache@clipmode{\graphicscache@clipmode{}cmyk}%
      \fi
      \ifdefempty{\graphicscache@outputicc}{}{%
        \edef\graphicscache@clipmode{\graphicscache@clipmode{}icc:\graphicscache@outputicc}%
      }%
      \edef\graphicscache@outputhash{\pdf@mdfivesum{\graphicscache@options\graphicscache@graphicsargs\graphicscache@clipmode\graphicscache@compress@mode\graphicscache@hashedname}}%
      \edef\graphicscache@output{\graphicscache@cachedir/\graphicscache@outputhash.pdf}%
      \ifgraphicscache@listing
        \PackageInfo{graphicscache}{graphicscache: includegraphics\{#2\} => \graphicscache@output}%
        \immediate\write\graphicscache@listout{\currfilepath:\number\inputlineno\space #2 [#1] [\graphicscache@graphicsargs] \graphicscache@fname\space \graphicscache@output}%
      \fi
      \graphicscache@work
    \else
      \PackageError{graphicscache}{Could not find file #2}{}%
    \fi
  \fi
  \endgroup
}
%    \end{macrocode}
%  \end{macro}
%  \begin{macro}{\includegraphicscache}
%    \begin{macrocode}
\newcommand{\includegraphicscache}[3][]{%
  \begingroup
  \expandarg
  \pgfkeys{/graphicscache/.cd,#2}%
  \includegraphics[#1]{#3}%
  \endgroup
}
%    \end{macrocode}
% \end{macro}
